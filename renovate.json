{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "extends": [
    "config:recommended"
  ],
  "minimumReleaseAge": "7 days",
  "includePaths": [
    ".github/actions/**",
    "bin/sigstore"
  ],
  "customManagers": [
    {
      "customType": "regex",
      "description": "Gems installed by the Sigstore signing script of the Gem Push and Sigstore Check actions",
      "managerFilePatterns": [
        "/^bin/sigstore$/"
      ],
      "matchStrings": [
        "gem install (?<depName>[a-z0-9_-]+) -v (?<currentValue>[0-9.]+)"
      ],
      "datasourceTemplate": "rubygems"
    }
  ],
  "packageRules": [
    {
      "matchManagers": [
        "github-actions"
      ],
      "pinDigests": true
    },
    {
      "description": "sigstore-cli does not work with json 3.x; Renovate keeps proposing it, merge once the Sigstore Check of a gem repo passes with it",
      "matchFileNames": [
        "bin/sigstore"
      ],
      "matchPackageNames": [
        "json"
      ],
      "automerge": false
    }
  ],
  "labels": [
    "dependencies"
  ]
}
